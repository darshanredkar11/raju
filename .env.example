# MongoDB Atlas Free. Set the real value in Render Environment, not in Git.
MONGODB_URI=mongodb+srv://USER:REDACTED@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sanjay_sales

# Google OAuth Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/auth/google/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true

# API-backed model; key is stored only in host environment
TAVILY_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4.1-mini

# Intentionally hard-disabled in this pilot. Do not change to enable sending.
OUTBOUND_EMAIL_ENABLED=false
